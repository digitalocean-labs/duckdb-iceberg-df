# name: test/sql/local/native_catalog/remove_orphan_files.test
# description: Orphan removal previews by default, floors destructive age, and fails closed on unsafe listings and references
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement error
select * from iceberg_remove_orphan_files(NULL);
----
table_name cannot be NULL

statement error
select * from iceberg_remove_orphan_files('my_datalake.default.anything', dry_run := NULL);
----
'dry_run' cannot be NULL

statement error
select * from iceberg_remove_orphan_files('my_datalake.default.anything', older_than := interval (-1) hour);
----
'older_than' must not be negative

statement error
select * from iceberg_remove_orphan_files('my_datalake.default.anything', older_than := interval 2000000 day);
----
'older_than' is too large

statement error
select * from iceberg_remove_orphan_files('my_datalake.default.anything', older_than := interval 59 minute, dry_run := false);
----
'older_than' must be at least 259200 seconds

statement ok
begin;

statement error
select * from iceberg_remove_orphan_files('my_datalake.default.anything');
----
cannot run inside an explicit transaction

statement ok
rollback;

statement ok
create table my_datalake.default.orphan_main (id integer) with ('format-version' = '2');

statement ok
insert into my_datalake.default.orphan_main values (1);

statement ok
insert into my_datalake.default.orphan_main values (2);

statement ok
set variable main_loc = (select regexp_replace(file_path, '/data/[^/]*$', '') from iceberg_metadata('my_datalake.default.orphan_main') where content = 'DATA' and status <> 'DELETED' limit 1);

statement ok
set variable main_candidate = (getvariable('main_loc') || '/data/orphan-young.parquet');

statement ok
copy (select 7 as x) to (getvariable('main_candidate')) (format parquet);

query I
select deleted_files from iceberg_remove_orphan_files('my_datalake.default.orphan_main', older_than := interval 59 minute);
----
0

query IIII
select orphan_files = 0, young_unreferenced >= 1, referenced_present > 0,
       listed_files = referenced_present + young_unreferenced + orphan_files
from iceberg_remove_orphan_files('my_datalake.default.orphan_main', older_than := interval 1 hour);
----
true	true	true	true

query I
select count(*) from glob(getvariable('main_candidate'));
----
1

statement error
select * from iceberg_remove_orphan_files('my_datalake.default.orphan_main', older_than := interval 3 day, dry_run := false);
----
ALLOW_LOCAL_FILE_ORPHAN_DELETION

statement ok
attach '' as orphan_local (type iceberg, uri 'http://iceberg-mock.invalid', authorization_type 'none', access_delegation_mode 'none', stage_create_tables true, default_schema 'default', allow_local_file_orphan_deletion true);

query III
select deleted_files, delete_errors, (select count(*) from glob(getvariable('main_candidate')))
from iceberg_remove_orphan_files('orphan_local.default.orphan_main', older_than := interval 3 day, dry_run := false);
----
0	0	1

statement ok
detach orphan_local;

statement ok
create table my_datalake.default.orphan_nested (id integer) with ('format-version' = '2');

statement ok
insert into my_datalake.default.orphan_nested values (1);

statement ok
set variable nested_loc = (select regexp_replace(file_path, '/data/[^/]*$', '') from iceberg_metadata('my_datalake.default.orphan_nested') where content = 'DATA' and status <> 'DELETED' limit 1);

statement ok
copy (select '{}') to (getvariable('nested_loc') || '/data/foreign.metadata.json') (format csv, header false, quote '', delimiter '');

statement error
select * from iceberg_remove_orphan_files('my_datalake.default.orphan_nested', older_than := interval 1 hour);
----
nested metadata marker

statement ok
create table my_datalake.default.orphan_paths (id integer) with ('format-version' = '2');

statement ok
insert into my_datalake.default.orphan_paths values (1);

statement ok
set variable paths_body = (select body from iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/orphan_paths', NULL));

statement ok
set variable relative_body = (select json_merge_patch(getvariable('paths_body')::json, json_object('metadata', json_object('location', 'relative/table'))));

query I
select status from iceberg_test_catalog_request('POST', '/__test/response', json_object('method', 'GET', 'path', '/v1/namespaces/default/tables/orphan_paths', 'status', 200, 'body', getvariable('relative_body')));
----
204

statement error
select * from iceberg_remove_orphan_files('my_datalake.default.orphan_paths', older_than := interval 1 hour);
----
not an absolute location

query I
select status from iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

statement ok
set variable paths_loc = (select regexp_replace(file_path, '/data/[^/]*$', '') from iceberg_metadata('my_datalake.default.orphan_paths') where content = 'DATA' and status <> 'DELETED' limit 1);

statement ok
set variable glob_body = (select json_merge_patch(getvariable('paths_body')::json, json_object('metadata', json_object('location', getvariable('paths_loc') || '/*'))));

query I
select status from iceberg_test_catalog_request('POST', '/__test/response', json_object('method', 'GET', 'path', '/v1/namespaces/default/tables/orphan_paths', 'status', 200, 'body', getvariable('glob_body')));
----
204

statement error
select * from iceberg_remove_orphan_files('my_datalake.default.orphan_paths', older_than := interval 1 hour);
----
contains glob characters

query I
select status from iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

statement ok
create table my_datalake.default.orphan_partial (id integer) with ('format-version' = '2');

statement ok
insert into my_datalake.default.orphan_partial values (1);

statement ok
set variable partial_list = (select manifest_list from iceberg_snapshots('my_datalake.default.orphan_partial') order by sequence_number desc limit 1);

statement ok
copy (select 'truncated') to (getvariable('partial_list')) (format csv, header false, quote '', delimiter '');

statement error
select * from iceberg_remove_orphan_files('my_datalake.default.orphan_partial', older_than := interval 1 hour);
